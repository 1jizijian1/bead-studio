<view class="page" wx:if="{{ready}}">
  <!-- 顶栏 -->
  <view class="topbar">
    <view class="back" bindtap="onBack">‹ 返回</view>
    <view class="title">{{name}}</view>
    <view class="reset" bindtap="onReset">重置</view>
  </view>

  <!-- 主角：现在在拼哪个色号、还剩多少颗 -->
  <view class="hero">
    <view class="hero-swatch" style="background:{{currentSwatch}}"></view>
    <view class="hero-meta">
      <view class="hero-label">现在拼</view>
      <view class="hero-key">{{currentKey}}</view>
    </view>
    <view class="hero-count">
      <view class="hero-remain">{{currentRemain}}<text class="hero-unit"> 颗没拼</text></view>
      <view class="hero-total">共 {{currentTotal}} 颗</view>
    </view>
    <view class="hero-nav">
      <view class="nav-btn" bindtap="onPrevColor">‹</view>
      <view class="nav-btn" bindtap="onNextColor">›</view>
    </view>
  </view>
  <view class="hero-bar">
    <view class="hero-fill" style="width:{{currentPercent}}%"></view>
  </view>

  <!-- 画布 -->
  <view class="canvas-wrap">
    <canvas
      type="2d"
      id="pattern"
      class="pattern"
      style="width:{{canvasW}}px;height:{{canvasH}}px;"
      bindtouchstart="onTouchStart"
      catchtouchmove="onTouchMove"
      bindtouchend="onTouchEnd"
      bindtouchcancel="onTouchEnd"
    ></canvas>

    <view class="zoom-badge" wx:if="{{zoom > 1.01}}" bindtap="onResetZoom">{{zoom}}× · 复位</view>
    <view class="save-warn" wx:if="{{saveError}}">⚠︎ 未保存</view>
    <view class="legend" wx:if="{{singleColor}}">只显示 {{currentKey}}</view>
  </view>

  <view class="hint">整张 {{progressPercent}}%（{{doneText}} 颗）· 长按标记整块 · 双指缩放</view>

  <!-- 主操作 -->
  <view class="actions">
    <view class="act-main" bindtap="onFinishColor">
      这盒 {{currentKey}} 拼完了（{{currentRemain}} 颗）→
    </view>
    <view class="act-side {{singleColor ? 'act-on' : ''}}" bindtap="onToggleSingleColor">
      {{singleColor ? '显示全部色' : '只看当前色'}}
    </view>
  </view>

  <!-- 色号列表 -->
  <scroll-view class="strip" scroll-x enhanced show-scrollbar="{{false}}">
    <view
      class="chip {{item.isCurrent ? 'chip-cur' : ''}} {{item.isDone ? 'chip-done' : ''}}"
      wx:for="{{colorList}}" wx:key="idx"
      data-idx="{{item.idx}}" bindtap="onColorTap"
    >
      <view class="chip-swatch" style="background:{{item.hex}}">
        <view class="chip-check" wx:if="{{item.isDone}}">✓</view>
      </view>
      <view class="chip-key">{{item.key}}</view>
      <view class="chip-num">{{item.done}}/{{item.total}}</view>
    </view>
  </scroll-view>
</view>

<view class="loading" wx:else>
  <text>加载中…</text>
</view>
