.page {
  padding: 0 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ---------- 顶栏 ---------- */
.topbar {
  display: flex;
  align-items: center;
  height: 84rpx;
}

.back {
  font-size: 28rpx;
  color: #6366f1;
  width: 130rpx;
}

.title {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.reset {
  width: 130rpx;
  text-align: right;
  font-size: 24rpx;
  color: #9ca3af;
}

/* ---------- 主角：当前色号 ---------- */
.hero {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 24rpx;
  background: #ffffff;
  border-radius: 20rpx 20rpx 0 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.hero-swatch {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  border: 3rpx solid rgba(0, 0, 0, 0.1);
  flex-shrink: 0;
}

.hero-meta {
  display: flex;
  flex-direction: column;
}

.hero-label {
  font-size: 20rpx;
  color: #9ca3af;
}

.hero-key {
  font-size: 42rpx;
  font-weight: 700;
  color: #1f2937;
  line-height: 1.15;
}

.hero-count {
  flex: 1;
  text-align: right;
}

.hero-remain {
  font-size: 40rpx;
  font-weight: 700;
  color: #6366f1;
}

.hero-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #6b7280;
}

.hero-total {
  font-size: 20rpx;
  color: #9ca3af;
  margin-top: 2rpx;
}

.hero-nav {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
}

.nav-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #f3f4f6;
  color: #4b5563;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-bar {
  height: 8rpx;
  background: #e5e7eb;
  border-radius: 0 0 6rpx 6rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.hero-fill {
  height: 100%;
  background: linear-gradient(90deg, #6366f1, #10b981);
  transition: width 0.18s linear;
}

/* ---------- 图纸（图片 + scroll-view） ---------- */
.canvas-box {
  position: relative;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.canvas-scroll {
  width: 100%;
  height: 100%;
}

.img-wrap {
  min-width: 100%;
  min-height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pattern-img {
  display: block;
}

.rendering {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6b7280;
  font-size: 26rpx;
}

.legend {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(99, 102, 241, 0.9);
  color: #ffffff;
  font-size: 20rpx;
}

.save-warn {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #fef3c7;
  color: #92400e;
  font-size: 20rpx;
}

/* ---------- 缩放 + 提示 ---------- */
.under {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 4rpx;
}

.zoom-row {
  display: flex;
  gap: 10rpx;
}

.zoom-btn {
  padding: 8rpx 20rpx;
  border-radius: 10rpx;
  background: #f3f4f6;
  color: #6b7280;
  font-size: 22rpx;
}

.zoom-on {
  background: #1f2937;
  color: #ffffff;
  font-weight: 600;
}

.hint {
  font-size: 20rpx;
  color: #9ca3af;
}

/* ---------- 主操作 ---------- */
.actions {
  display: flex;
  gap: 14rpx;
  padding-bottom: 12rpx;
}

.act-main {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 22rpx rgba(99, 102, 241, 0.28);
}

.act-side {
  flex-shrink: 0;
  padding: 26rpx 24rpx;
  border-radius: 18rpx;
  background: #f3f4f6;
  color: #4b5563;
  font-size: 25rpx;
}

.act-on {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: #ffffff;
  font-weight: 600;
}

/* ---------- 色号列表 ---------- */
.strip {
  white-space: nowrap;
  padding-bottom: 8rpx;
}

.chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  margin-right: 14rpx;
  padding: 12rpx 16rpx;
  background: #ffffff;
  border-radius: 14rpx;
  border: 3rpx solid transparent;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.chip-cur {
  border-color: #6366f1;
}

.chip-done {
  opacity: 0.55;
}

.chip-swatch {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  border-radius: 10rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.chip-check {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
  text-shadow: 0 0 6rpx rgba(0, 0, 0, 0.6);
}

.chip-key {
  font-size: 20rpx;
  color: #374151;
  font-weight: 600;
}

.chip-num {
  font-size: 18rpx;
  color: #9ca3af;
}

/* ---------- 撤销 ---------- */
.undo-fab {
  position: fixed;
  right: 28rpx;
  bottom: calc(210rpx + env(safe-area-inset-bottom));
  padding: 18rpx 30rpx;
  border-radius: 999rpx;
  background: rgba(31, 41, 55, 0.9);
  color: #ffffff;
  font-size: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.2);
}

.undo-dim {
  opacity: 0.35;
}

/* ---------- 隐藏渲染画布：只用来出图，不参与显示 ---------- */
.hidden-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  opacity: 0;
  pointer-events: none;
}
