<view class="page">
  <view class="usage {{usageWarn ? 'usage-warn' : ''}}" wx:if="{{list.length}}">
    <text>{{usageText}}</text>
    <text wx:if="{{usageWarn}}">· 快满了，建议删掉不再拼的项目</text>
  </view>

  <view class="empty" wx:if="{{empty}}">
    <view class="empty-title">还没有拼豆项目</view>
    <view class="empty-desc">生成一张图纸后，点「开始拼豆」<br/>进度就会出现在这里</view>
    <view class="empty-btn" bindtap="onGoGenerate">去生成一张图纸</view>
  </view>

  <view
    class="item"
    wx:for="{{list}}"
    wx:key="id"
    data-id="{{item.id}}"
    bindtap="onOpen"
  >
    <!-- 打卡过的直接显示照片；没有的才画图纸缩略图 -->
    <image
      wx:if="{{item.cover}}"
      class="thumb"
      src="{{item.cover}}"
      mode="aspectFill"
    />
    <canvas wx:else type="2d" class="thumb thumb-canvas"></canvas>

    <view class="info">
      <view class="row-top">
        <text class="name">{{item.name}}</text>
        <text class="dims">{{item.dims}}</text>
      </view>
      <view class="bar">
        <view class="bar-fill" style="width:{{item.percent}}%"></view>
      </view>
      <view class="row-bottom">
        <text class="progress {{item.finished ? 'finished' : ''}}">
          {{item.finished ? '已完成' : item.percent + '%'}} · {{item.done}}/{{item.total}} 颗
        </text>
        <text class="time">{{item.updated}}</text>
      </view>
    </view>

    <view class="row-actions">
      <view
        wx:if="{{item.finished}}"
        class="act act-hi"
        data-id="{{item.id}}"
        catchtap="onCheckin"
      >打卡</view>
      <view
        class="act"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
        catchtap="onDelete"
      >删除</view>
    </view>
  </view>
</view>
