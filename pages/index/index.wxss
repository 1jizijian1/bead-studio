.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 0 48rpx;
}

/* ---------- 品牌区 ---------- */
.brand {
  padding-top: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.bead-logo {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(99, 102, 241, 0.16);
}

.bead-row {
  display: flex;
  gap: 10rpx;
}

.bead {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  box-shadow: inset 0 -4rpx 8rpx rgba(0, 0, 0, 0.14);
}

.bead-1 { background: #6366f1; }
.bead-2 { background: #8b5cf6; }
.bead-3 { background: #f472b6; }
.bead-4 { background: #38bdf8; }
.bead-5 { background: #fbbf24; }
.bead-6 { background: #f87171; }
.bead-7 { background: #34d399; }
.bead-8 { background: #a78bfa; }
.bead-9 { background: #fb923c; }

.brand-title {
  margin-top: 48rpx;
  font-size: 52rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #1f2937;
}

.brand-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #6b7280;
}

/* ---------- 主入口 ---------- */
.actions {
  margin-top: 96rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.pick-card {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  border-radius: 28rpx;
  padding: 64rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #ffffff;
  box-shadow: 0 12rpx 40rpx rgba(99, 102, 241, 0.28);
}

.pick-card-hover {
  opacity: 0.88;
  transform: scale(0.985);
}

.pick-plus {
  font-size: 72rpx;
  line-height: 1;
  font-weight: 300;
  opacity: 0.95;
}

.pick-title {
  margin-top: 24rpx;
  font-size: 36rpx;
  font-weight: 600;
}

.pick-title.small {
  font-size: 32rpx;
}

.pick-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.82;
}

.pick-card.secondary {
  background: #ffffff;
  color: #1f2937;
  padding: 44rpx 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.pick-card.secondary .pick-desc {
  opacity: 1;
  color: #6b7280;
}

/* ---------- 选图建议 ---------- */
.tip-card {
  margin-top: 8rpx;
  padding: 28rpx 32rpx;
  border-radius: 20rpx;
  background: #eef2ff;
  border-left: 6rpx solid #6366f1;
}

.tip-card-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #4338ca;
}

.tip-card-body {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #4f46e5;
}

/* ---------- 继续上次 ---------- */
.resume {
  margin-top: 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: #6366f1;
  padding: 24rpx;
}

/* ---------- 页脚 ---------- */
.footer {
  margin-top: auto;
  padding: 60rpx 0 48rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9ca3af;
}
