<view class="page">
  <!-- 图纸：图片显示，scroll-view 负责平移 -->
  <view class="canvas-box" style="height:{{boxH}}px;">
    <scroll-view class="canvas-scroll" scroll-x scroll-y enhanced show-scrollbar="{{false}}">
      <view class="img-wrap">
        <image
          class="preview-img"
          src="{{previewSrc}}"
          mode="scaleToFill"
          style="width:{{imgW}}px;height:{{imgH}}px;"
          bindtouchstart="onTouchStart"
          bindtouchend="onTouchEnd"
          bindtouchcancel="onTouchEnd"
        />
      </view>
    </scroll-view>

    <view class="rendering" wx:if="{{busy}}">
      <view class="busy-bar">
        <view class="busy-fill" style="width:{{progressPercent}}%"></view>
      </view>
      <view class="busy-text">{{busyText}}</view>
    </view>

    <view class="legend">点格子看色号</view>
  </view>

  <!-- 缩放 -->
  <view class="under">
    <view class="zoom-row">
      <view
        class="zoom-btn {{zoom === item ? 'zoom-on' : ''}}"
        wx:for="{{zoomSteps}}" wx:key="*this"
        data-zoom="{{item}}" bindtap="onZoomChange"
      >{{item}}×</view>
    </view>
    <view class="hint">双指缩放看细节 · 拖动平移</view>
  </view>

  <!-- 点格子提示 -->
  <view class="tip" wx:if="{{tip}}">
    <view class="tip-swatch" style="background:{{tip.color}};"></view>
    <text class="tip-key">{{tip.isExternal ? '空白' : tip.key}}</text>
    <text class="tip-hex">{{tip.isExternal ? '' : tip.color}}</text>
    <text class="tip-close" bindtap="onCloseTip">×</text>
  </view>

  <!-- 概览 -->
  <view class="info-bar">
    <view class="info-item">
      <text class="info-value">{{dims.N}}×{{dims.M}}</text>
      <text class="info-label">格子</text>
    </view>
    <view class="info-item">
      <text class="info-value">{{colorList.length}}</text>
      <text class="info-label">颜色</text>
    </view>
    <view class="info-item">
      <text class="info-value">{{totalBeadCount}}</text>
      <text class="info-label">总豆数</text>
    </view>
  </view>

  <!-- 颜色清单（点一下可排除） -->
  <scroll-view class="color-strip" scroll-x wx:if="{{colorList.length}}" enhanced show-scrollbar="{{false}}">
    <view
      class="chip {{item.excluded ? 'chip-off' : ''}}"
      wx:for="{{colorList}}"
      wx:key="hex"
      data-hex="{{item.hex}}"
      bindtap="onToggleColor"
    >
      <view class="chip-swatch" style="background:{{item.color}};"></view>
      <view class="chip-key">{{item.key}}</view>
      <view class="chip-count">{{item.count}}</view>
    </view>
  </scroll-view>

  <!-- 参数面板 -->
  <view class="panel">
    <view class="param">
      <view class="param-head">
        <text class="param-name">豆子尺寸</text>
      </view>
      <view class="segmented">
        <view
          class="seg {{beadPitch === item.value ? 'seg-on' : ''}}"
          wx:for="{{pitches}}" wx:key="value"
          data-pitch="{{item.value}}" bindtap="onPitchChange"
        >{{item.label}}</view>
      </view>
      <view class="param-hint">标准的 5mm 豆最常见；迷你 2.6mm 成品只有一半大</view>
    </view>

    <view class="param">
      <view class="param-head">
        <text class="param-name">成品宽度</text>
        <text class="param-value">{{widthCm}} cm</text>
      </view>
      <slider
        min="{{widthMin}}" max="{{widthMax}}" value="{{widthCm}}"
        block-size="22" activeColor="#6366f1" backgroundColor="#e5e7eb"
        bindchanging="onWidthChanging" bindchange="onWidthChange"
      />
      <view class="size-readout {{tooBig ? 'size-readout-warn' : ''}}">
        <text>约 {{sizeText}}</text>
        <text class="readout-dot">·</text>
        <text>{{gridText}}</text>
        <text class="readout-dot">·</text>
        <text>{{boardText}}</text>
      </view>
      <view class="param-hint warn" wx:if="{{tooBig}}">
        成品偏大，手工拼会很久。调小宽度、或换成迷你豆会好拼很多。
      </view>
    </view>

    <view class="param">
      <view class="param-head">
        <text class="param-name">颜色合并阈值</text>
        <text class="param-value">{{threshold}}</text>
      </view>
      <slider
        min="{{thresholdMin}}" max="{{thresholdMax}}" value="{{threshold}}"
        block-size="22" activeColor="#8b5cf6" backgroundColor="#e5e7eb"
        bindchanging="onThresholdChanging" bindchange="onThresholdChange"
      />
      <view class="param-hint">把相近的色号合并成一个。0 = 完全不合并；照片建议 5~12，扁平色块的卡通图可以调更高</view>
    </view>

    <view class="param">
      <view class="param-head">
        <text class="param-name">杂色清理</text>
        <text class="param-value">{{minRegion}}</text>
      </view>
      <slider
        min="{{minRegionMin}}" max="{{minRegionMax}}" value="{{minRegion}}"
        block-size="22" activeColor="#10b981" backgroundColor="#e5e7eb"
        bindchanging="onMinRegionChanging" bindchange="onMinRegionChange"
      />
      <view class="param-hint">{{speckleText}}</view>
    </view>

    <view class="param">
      <view class="param-head">
        <text class="param-name">像素化模式</text>
      </view>
      <view class="segmented">
        <view
          class="seg {{mode === item.value ? 'seg-on' : ''}}"
          wx:for="{{modes}}" wx:key="value"
          data-mode="{{item.value}}" bindtap="onModeChange"
        >{{item.label}}</view>
      </view>
      <view class="param-hint">{{modeDesc}}</view>
    </view>

    <view class="param">
      <view class="param-head">
        <text class="param-name">店家色号体系</text>
      </view>
      <scroll-view scroll-x enhanced show-scrollbar="{{false}}">
        <view class="segmented nowrap">
          <view
            class="seg {{colorSystem === item ? 'seg-on' : ''}}"
            wx:for="{{colorSystems}}" wx:key="*this"
            data-system="{{item}}" bindtap="onColorSystemChange"
          >{{item}}</view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 操作 -->
  <view class="actions">
    <view class="btn ghost" bindtap="onRemoveBackground">一键去背景</view>
    <view class="btn ghost" bindtap="onUndoBackground">撤销</view>
    <view class="btn primary" bindtap="onExport">导出图纸</view>
  </view>

  <!-- 拼豆进度模式：出图纸之后的下一步 -->
  <view class="btn primary block" bindtap="onStartProgress">
    开始拼豆 · 对着手机一颗颗拼
  </view>

  <!-- 隐藏的导出画布：canvasToTempFilePath 只认页面里的真实 canvas 节点 -->
  <canvas type="2d" id="export" class="export-canvas" style="width:{{exportCssW}}px;height:{{exportCssH}}px;"></canvas>

  <!-- 隐藏的预览渲染画布：只用来出图，不参与显示 -->
  <canvas type="2d" id="render" class="export-canvas" style="width:{{rw}}px;height:{{rh}}px;"></canvas>
</view>
