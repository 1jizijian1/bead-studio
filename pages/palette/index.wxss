.page {
  padding: 24rpx 24rpx 200rpx;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.card-hint {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 10rpx;
  line-height: 1.5;
}

.count {
  font-size: 24rpx;
  color: #6366f1;
  font-weight: 600;
}

/* ---------- 色号体系 ---------- */
.segmented {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.segmented.nowrap {
  display: inline-flex;
  white-space: nowrap;
}

.seg {
  padding: 14rpx 28rpx;
  border-radius: 14rpx;
  background: #f3f4f6;
  color: #6b7280;
  font-size: 26rpx;
}

.seg-on {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: #ffffff;
  font-weight: 600;
}

/* ---------- 快捷操作 ---------- */
.quick {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0 8rpx;
}

.quick-btn {
  padding: 12rpx 28rpx;
  border-radius: 12rpx;
  background: #f3f4f6;
  color: #4b5563;
  font-size: 24rpx;
}

/* ---------- 色块网格 ---------- */
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.cell {
  width: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.cell-off {
  opacity: 0.28;
}

.cell-swatch {
  position: relative;
  width: 76rpx;
  height: 76rpx;
  border-radius: 14rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cell-check {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  text-shadow: 0 0 6rpx rgba(0, 0, 0, 0.55);
}

.cell-key {
  font-size: 20rpx;
  color: #6b7280;
}

/* ---------- 底部 ---------- */
.footer-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.btn {
  text-align: center;
  padding: 28rpx 0;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.btn.primary {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(99, 102, 241, 0.3);
}
